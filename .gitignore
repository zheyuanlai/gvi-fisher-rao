.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
.mypy_cache/
.ruff_cache/
build/
dist/

# Private manuscript, source papers, and local documentation details.
references/
# Drafted manuscript prose belongs with the manuscript, not in the public code
# repository; the repository publishes what produced the numbers, not the paper.
reports/NUMERICAL_SECTION.tex
# Process notes and external review documents: useful while the work is in flight,
# not part of what a reader needs to reproduce the campaign.
/AUDIT.md
reports/OVERNIGHT_SUMMARY.md
reports/BLOCKED_EXPERIMENTS.md
# Gate output, rewritten by make audit / make manuscript-audit / the plot audit.
reports/*.json
docs/_build/
docs/private/
notes/
site/
*.draft.md
*.notes.md
*.draft.tex
*.notes.tex

# LaTeX build byproducts; manuscript sources and reference PDFs remain trackable.
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.nav
*.out
*.run.xml
*.snm
*.synctex.gz
*.toc
*.vrb
*.xdv
_minted-*/

# Editor and operating-system noise.
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Core/full campaigns can be regenerated; keep smoke artifacts and manifests.
results/raw/core/
results/raw/full/
results/raw/appendix/
results/logs/*.log
results/processed/*.csv
results/figures/*.png
results/figures/*.pdf
!results/processed/.gitkeep
!results/figures/.gitkeep
!results/processed/main_figure_*.csv
!results/figures/main_figure_*.png
!results/figures/main_figure_*.pdf

# Full-tier manifests are provenance for gitignored raw data; keeping thousands
# of them in the index also makes every new manifest embed a huge status listing.
results/manifests/full/
results/manifests/appendix/
results/manifests/core/
results/manifests/state_shards/
results/manifests/reference_*.json
results/manifests/campaign_state.json
results/tables/*.csv
results/tables/*.tex

# The manuscript campaign is the citable one: its figures, panel data, tables and
# per-run manifests are tracked, and only its bulk trajectories are regenerable.
results/raw/manuscript/
!results/tables/manuscript_*.csv
!results/tables/manuscript_*.tex
